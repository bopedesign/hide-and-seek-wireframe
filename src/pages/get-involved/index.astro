---
import Layout from '../../layouts/Layout.astro';
---
<Layout {...{"title": "Get Involved | Hide and Seek Day Camp", "description": "Every one of these keeps camp running.", "path": "/get-involved/", "banner": {"img": "/img/a08.webp", "alt": "Staff and volunteers", "eyebrow": "Get Involved", "title": "Work a summer, run a race, or give", "intro": "Every one of these keeps camp running.", "h1": "eyebrow", "crumb": null}}}>
  <div class="sec"><div class="wrap g2">
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/a30.webp" alt="Counselors"></div><div><h2 class="h3">Work at Camp</h2><p class="s" style="margin-bottom:12px">Summer staff and counselor roles, plus what training looks like.</p><a href="/get-involved/work-at-camp/" class="lk">Open</a></div></div>
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/a09.webp" alt="Staff"></div><div><h2 class="h3">Apply</h2><p class="s" style="margin-bottom:12px">The staff applications, hosted on UltraCamp.</p><a href="/get-involved/apply/" class="lk">Open</a></div></div>
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/a08.webp" alt="5K runners"></div><div><h2 class="h3">Hickory FlatOut 5K</h2><p class="s" style="margin-bottom:12px">Labor Day morning, a Peachtree qualifier, with a kids fun run.</p><a href="/get-involved/hickory-flatout-5k/" class="lk">Open</a></div></div>
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/a43.webp" alt="The banquet"></div><div><h2 class="h3">Annual Banquet</h2><p class="s" style="margin-bottom:12px">A spring evening for the people who support camp.</p><a href="/get-involved/annual-banquet/" class="lk">Open</a></div></div>
  </div></div>
  <div class="navyband" style="padding:60px clamp(20px,3vw,40px);border-radius:36px 36px 0 0"><div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
    <h2 class="h2" style="color:#fff;margin:0">Give to Seek Ministries</h2><a href="https://www.ultracamp.com/donations/donationselection.aspx?idCamp=307&amp;campCode=hns&amp;idDonationCategory=2574" data-ev="donate_click" target="_blank" rel="noopener" class="gold">Donate</a>
  </div></div>
</Layout>
