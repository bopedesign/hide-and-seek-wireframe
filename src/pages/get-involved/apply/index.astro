---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Apply to Work at Camp | Hide and Seek Day Camp", "description": "Pick the application that matches the position you want. Applications are hosted on UltraCamp and open in a new tab.", "path": "/get-involved/apply/", "banner": {"pos": "75% 40%", "img": "/img/involved-01.webp", "alt": "Counselors with the camp utility vehicle", "eyebrow": "Apply", "title": "Apply to work at camp", "intro": "Pick the application that matches the position you want. Applications are hosted on UltraCamp and open in a new tab.", "h1": "title", "crumb": {"href": "/get-involved/", "label": "Get Involved"}}}}>
  <div class="sec"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">Choose your application</h2>
    <div class="g2">
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:18px"><div><h3 class="h3">New Counselor and Junior Counselor</h3><p class="s">First time on staff at Hide and Seek</p></div><a href="https://www.ultracamp.com/info/upcomingsessions.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="apply_click" target="_blank" rel="noopener" class="navy" style="white-space:nowrap">Apply</a></div>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:18px"><div><h3 class="h3">Return Counselor and Junior Counselor</h3><p class="s">You have worked a summer with us before</p></div><a href="https://www.ultracamp.com/info/upcomingsessions.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="apply_click" target="_blank" rel="noopener" class="navy" style="white-space:nowrap">Apply</a></div>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:18px"><div><h3 class="h3">Middle School Week Staff</h3><p class="s">SEEK Adventure week at Hickory Flat</p></div><a href="https://www.ultracamp.com/info/upcomingsessions.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="apply_click" target="_blank" rel="noopener" class="navy" style="white-space:nowrap">Apply</a></div>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:18px"><div><h3 class="h3">Director</h3><p class="s">Education background and experience required</p></div><a href="https://www.ultracamp.com/info/upcomingsessions.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="apply_click" target="_blank" rel="noopener" class="navy" style="white-space:nowrap">Apply</a></div>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:18px"><div><h3 class="h3">Program Director</h3><p class="s">Age 18+, camp or education experience preferred</p></div><a href="https://www.ultracamp.com/info/upcomingsessions.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="apply_click" target="_blank" rel="noopener" class="navy" style="white-space:nowrap">Apply</a></div>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:18px"><div><h3 class="h3">Time Off Request</h3><p class="s">For staff already hired for the summer</p></div><span class="ghostD" style="white-space:nowrap">Open form</span></div>
    </div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">What you will need</h2>
    <div class="g4">
      <div class="card"><h3 class="h3" style="margin:0">Contact details</h3></div>
      <div class="card"><h3 class="h3" style="margin:0">Several references</h3></div>
      <div class="card"><h3 class="h3" style="margin:0">Availability by session</h3></div>
      <div class="card"><h3 class="h3" style="margin:0">Consent to a background check</h3></div>
    </div>
    <p class="s" style="margin-top:20px">Counselors must also pass a ropes course facilitation training program before being hired on staff.</p>
  </div></div>
</Layout>
