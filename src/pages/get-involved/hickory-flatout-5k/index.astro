---
import Layout from '../../../layouts/Layout.astro';

// 2026 sponsors, in the order the team chose. Logos live in public/img/sponsors/.
// A sponsor with a url gets its logo linked to that site; leave url off to show the logo only.
const sponsors2026 = [
  { name: 'Southeast Restoration', logo: '/img/sponsors/southeast-restoration.webp', url: 'https://www.southeastrestoration.com/' },
  { name: 'Connelly Residential Services', logo: '/img/sponsors/connelly.webp', url: 'https://www.connellyresidentialservices.com/' },
  { name: 'Pinnacle Pools and Spas', logo: '/img/sponsors/pinnacle-pools.webp', url: 'https://pinnaclepoolsandspas.com/pool-builders/georgia/north-atlanta/' },
  { name: 'Chick-fil-A Canton', logo: '/img/sponsors/chick-fil-a.webp', url: 'https://www.cfacanton.com/' },
  { name: 'M Jones Heating and Cooling', logo: '/img/sponsors/m-jones.webp', url: 'https://mjoneshvac.com/' },
  { name: 'Valor Environmental', logo: '/img/sponsors/valor.webp', url: 'https://www.valorenv.com/' },
  { name: 'Crose Law', logo: '/img/sponsors/crose-law.webp', url: 'https://www.croselaw.com/' },
  { name: 'State Farm, Jason Davidson', logo: '/img/sponsors/state-farm-jason-davidson.webp', url: 'https://www.statefarm.com/agent/us/ga/canton/jason-davidson-2jkw71ys000' },
  { name: 'Fly and Form Concrete Structures', logo: '/img/sponsors/fly-and-form.webp', url: 'https://www.flyandform.com/' },
  { name: 'Flat Out Fitness Boot Camp', logo: '/img/sponsors/flat-out-fitness.webp', url: 'https://flatoutfitnesshf.com/' },
  { name: 'Lakota Springs', logo: '/img/sponsors/lakota-springs.webp', url: 'https://lakotaspringwater.com/' },
  { name: 'Jetset Modern Pilates', logo: '/img/sponsors/jetset-pilates.webp', url: 'https://jetsetpilates.com/ga/alpharetta/' },
  { name: 'Bope', logo: '/img/sponsors/bope.webp', url: 'https://bopedesign.com/' },
  { name: 'Mottion Media', logo: '/img/sponsors/mottion-media.webp' },
  { name: 'Mt. Zion Baptist Church', logo: '/img/sponsors/mt-zion.webp', url: 'https://www.mtzb.org/' },
  { name: 'Sixes Church', logo: '/img/sponsors/sixes-church.webp', url: 'https://www.sixes.church/' },
  { name: 'Ball Ground Methodist Church', logo: '/img/sponsors/ball-ground-methodist.webp', url: 'https://ngagmc.org/directory/ball-ground-methodist/' },
];
// 2027 sponsor packet flyer: save the PDF in public/files/ and put its address here, for example
// '/files/sponsor-packet-2027.pdf'. The button links to it once this is set.
const sponsorPacket2027 = '/files/sponsor-packet-2027.pdf';
---
<Layout {...{"title": "Hickory FlatOut 5K | Hide and Seek Day Camp", "description": "A Peachtree qualifier open to all ages, with a kids Fun Run right after.", "path": "/get-involved/hickory-flatout-5k/", "banner": {"img": "/img/5k-banner.webp", "alt": "Runners on the road during the Hickory FlatOut 5K", "pos": "50% 35%", "eyebrow": "Hickory FlatOut 5K", "title": "Run with us on Labor Day morning", "intro": "A Peachtree qualifier open to all ages, with a kids Fun Run right after.", "h1": "eyebrow", "crumb": {"href": "/get-involved/", "label": "Get Involved"}}}}>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:start">
    <div><p class="eyebrow">Labor Day morning</p><h2 class="h2">A Peachtree qualifier through Hickory Flat</h2><p class="p">The race runs at Mt. Zion Baptist Church and the streets around the Hickory Flat campus. Open to all ages, with a kids Fun Run right after.</p><div class="row" style="margin-top:20px"><a href="https://raceroster.com/events/2026/109639/hickory-flatout-5k" data-ev="race_register_click" target="_blank" rel="noopener" class="gold">Register for the race</a><span class="ghostD">Become a sponsor</span></div></div>
    <div class="card"><p class="eyebrow" style="margin-bottom:6px">When</p><p class="s" style="margin-bottom:18px">Labor Day morning</p><p class="eyebrow" style="margin-bottom:6px">Where</p><p class="s" style="margin-bottom:18px">Mt. Zion Baptist Church, 4096 East Cherokee Drive, Canton</p><p class="eyebrow" style="margin-bottom:6px">Races</p><p class="s" style="margin-bottom:18px">Main 5K, then the kids Fun Run</p><p class="eyebrow" style="margin-bottom:6px">Timing</p><p class="s">Certified as a Peachtree qualifier</p></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:28px">The course</h2>
    <div class="g2">
      <div class="ph" style="height:300px;background:#e4eef7;display:flex;align-items:center;justify-content:center"><p class="s" style="font-weight:600;color:#245b83">2027 Course Map Pending</p></div>
      <div class="ph" style="height:300px"><img src="/img/5k-course.webp" alt="Runners following the yellow center line on the 5K course"></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap">
    <h2 class="h2">Sponsors</h2><p class="p" style="margin-bottom:28px">Sponsors set up booths at the event and are listed here and on the race shirt.</p>
    <h3 class="h3" style="margin-bottom:16px">Thank you to our 2026 sponsors</h3>
    <div class="sponsor-logos">
      {sponsors2026.map((sp) => sp.url
        ? <a class="card" href={sp.url} data-ev="sponsor_logo_click" target="_blank" rel="sponsored noopener"><img src={sp.logo} alt={sp.name} loading="lazy"></a>
        : <div class="card"><img src={sp.logo} alt={sp.name} loading="lazy"></div>)}
    </div>
    <p class="eyebrow" style="margin:44px 0 6px">Labor Day 2027</p>
    <h3 class="h3" style="margin-bottom:12px">Want to sponsor our next race?</h3>
    <p class="p" style="margin-bottom:20px">All sponsorship proceeds benefit Hide and Seek Day Camp. The sponsor packet lists every level, from a $150 vendor table in the staging area to title sponsor.</p>
    <div class="row">
      {sponsorPacket2027
        ? <a href={sponsorPacket2027} data-ev="sponsor_packet_click" target="_blank" rel="noopener" class="gold">Sponsor packet</a>
        : <span class="gold">Sponsor packet</span>}
    </div>
  </div></div>
  <div class="sec" style="padding-top:0"><div class="wrap g4">
    <div class="ph" style="height:200px"><img src="/img/5k-start-line.webp" alt="Runners lined up at the 5K start line" style="object-position:50% 45%"></div>
    <div class="ph" style="height:200px"><img src="/img/5k-fun-run-start.webp" alt="Kids running out of the start arch at the Fun Run"></div>
    <div class="ph" style="height:200px"><img src="/img/5k-kids-medals.webp" alt="Three kids standing in front of the 1st, 2nd and 3rd place banners" style="object-position:50% 70%"></div>
    <div class="ph" style="height:200px"><img src="/img/5k-family-fun-run.webp" alt="Parents cheering on a young child running the Fun Run"></div>
  </div></div>
</Layout>
