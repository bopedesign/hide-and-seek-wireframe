---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Hickory FlatOut 5K | Hide and Seek Day Camp", "description": "A Peachtree qualifier open to all ages, with a kids fun run right after.", "path": "/get-involved/hickory-flatout-5k/", "banner": {"img": "/img/a08.webp", "alt": "Runners at the 5K", "eyebrow": "Hickory FlatOut 5K", "title": "Run with us on Labor Day morning", "intro": "A Peachtree qualifier open to all ages, with a kids fun run right after.", "h1": "eyebrow", "crumb": {"href": "/get-involved/", "label": "Get Involved"}}}}>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:start">
    <div><p class="eyebrow">Labor Day morning</p><h2 class="h2">A Peachtree qualifier through Hickory Flat</h2><p class="p">The race runs at Mt. Zion Baptist Church and the streets around the Hickory Flat campus. Open to all ages, with a kids fun run right after.</p><div class="row" style="margin-top:20px"><span class="gold">Register for the race</span><span class="ghostD">Become a sponsor</span></div></div>
    <div class="card"><p class="eyebrow" style="margin-bottom:6px">When</p><p class="s" style="margin-bottom:18px">Labor Day morning</p><p class="eyebrow" style="margin-bottom:6px">Where</p><p class="s" style="margin-bottom:18px">Mt. Zion Baptist Church, 4096 East Cherokee Drive, Canton</p><p class="eyebrow" style="margin-bottom:6px">Races</p><p class="s" style="margin-bottom:18px">Main 5K, then the kids fun run</p><p class="eyebrow" style="margin-bottom:6px">Timing</p><p class="s">Certified as a Peachtree qualifier</p></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:28px">The course</h2>
    <div class="g2">
      <div class="ph" style="height:300px;background:#e4eef7;display:flex;align-items:center;justify-content:center"><p class="s" style="font-weight:600;color:#245b83">Course map</p></div>
      <div class="ph" style="height:300px"><img src="/img/a08.webp" alt="Runners on the course"></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap">
    <h2 class="h2">Sponsors</h2><p class="p" style="margin-bottom:28px">Sponsors set up booths at the event and are listed here and on the race shirt.</p>
    <div class="g4">
      <div class="card" style="height:90px;display:flex;align-items:center;justify-content:center"><p class="s">Sponsor logo</p></div>
      <div class="card" style="height:90px;display:flex;align-items:center;justify-content:center"><p class="s">Sponsor logo</p></div>
      <div class="card" style="height:90px;display:flex;align-items:center;justify-content:center"><p class="s">Sponsor logo</p></div>
      <div class="card" style="height:90px;display:flex;align-items:center;justify-content:center"><p class="s">Sponsor logo</p></div>
    </div>
    <div class="row" style="margin-top:28px"><span class="ghostD">Sponsor packet</span></div>
  </div></div>
  <div class="sec" style="padding-top:0"><div class="wrap g4">
    <div class="ph" style="height:200px"><img src="/img/a09.webp" alt="Race photo"></div>
    <div class="ph" style="height:200px"><img src="/img/a39.webp" alt="Race photo"></div>
    <div class="ph" style="height:200px"><img src="/img/a40.webp" alt="Race photo"></div>
    <div class="ph" style="height:200px"><img src="/img/a10.webp" alt="Race photo"></div>
  </div></div>
</Layout>
