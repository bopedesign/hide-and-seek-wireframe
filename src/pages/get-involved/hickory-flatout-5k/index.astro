---
import Layout from '../../../layouts/Layout.astro';

// 2026 sponsors: the thank you graphic from the 2026 race, with every sponsor's logo on it.
const sponsorBoard2026 = '/img/sponsors-2026.webp';
// 2027 sponsor packet flyer: save the PDF in public/files/ and put its address here, for example
// '/files/sponsor-packet-2027.pdf'. The button links to it once this is set.
const sponsorPacket2027 = '';
---
<Layout {...{"title": "Hickory FlatOut 5K | Hide and Seek Day Camp", "description": "A Peachtree qualifier open to all ages, with a kids Fun Run right after.", "path": "/get-involved/hickory-flatout-5k/", "banner": {"img": "/img/summer-10.webp", "alt": "Campers playing field games", "eyebrow": "Hickory FlatOut 5K", "title": "Run with us on Labor Day morning", "intro": "A Peachtree qualifier open to all ages, with a kids Fun Run right after.", "h1": "eyebrow", "crumb": {"href": "/get-involved/", "label": "Get Involved"}}}}>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:start">
    <div><p class="eyebrow">Labor Day morning</p><h2 class="h2">A Peachtree qualifier through Hickory Flat</h2><p class="p">The race runs at Mt. Zion Baptist Church and the streets around the Hickory Flat campus. Open to all ages, with a kids Fun Run right after.</p><div class="row" style="margin-top:20px"><a href="https://raceroster.com/events/2026/109639/hickory-flatout-5k" data-ev="race_register_click" target="_blank" rel="noopener" class="gold">Register for the race</a><span class="ghostD">Become a sponsor</span></div></div>
    <div class="card"><p class="eyebrow" style="margin-bottom:6px">When</p><p class="s" style="margin-bottom:18px">Labor Day morning</p><p class="eyebrow" style="margin-bottom:6px">Where</p><p class="s" style="margin-bottom:18px">Mt. Zion Baptist Church, 4096 East Cherokee Drive, Canton</p><p class="eyebrow" style="margin-bottom:6px">Races</p><p class="s" style="margin-bottom:18px">Main 5K, then the kids Fun Run</p><p class="eyebrow" style="margin-bottom:6px">Timing</p><p class="s">Certified as a Peachtree qualifier</p></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:28px">The course</h2>
    <div class="g2">
      <div class="ph" style="height:300px;background:#e4eef7;display:flex;align-items:center;justify-content:center"><p class="s" style="font-weight:600;color:#245b83">Course map</p></div>
      <div class="ph" style="height:300px"><img src="/img/gallery-dsc00067.webp" alt="Campers running and playing on the field" style="object-position:50% 45%"></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap">
    <h2 class="h2">Sponsors</h2><p class="p" style="margin-bottom:28px">Sponsors set up booths at the event and are listed here and on the race shirt.</p>
    <h3 class="h3" style="margin-bottom:16px">2026 sponsors</h3>
    <img src={sponsorBoard2026} alt="Thank you to our 2026 sponsors: Chick-fil-A Canton, M Jones Heating and Cooling, Connelly Residential Services, Pinnacle Pools and Spas, Valor Environmental, Crose Law, State Farm agent Jason Davidson, Fly and Form Concrete Structures, Southeast Restoration, Flat Out Fitness Boot Camp, Lakota Springs, Mt. Zion Baptist Church, Sixes Church, Ball Ground Methodist Church, Hide and Seek Day Camp, Jetset Modern Pilates, and Bope" width="1600" height="870" loading="lazy" style="display:block;width:100%;height:auto;border-radius:22px">
    <h3 class="h3" style="margin:44px 0 16px">2027 sponsors</h3>
    <div class="row">
      {sponsorPacket2027
        ? <a href={sponsorPacket2027} data-ev="sponsor_packet_click" target="_blank" rel="noopener" class="gold">Sponsor packet</a>
        : <span class="gold">Sponsor packet</span>}
    </div>
  </div></div>
  <div class="sec" style="padding-top:0"><div class="wrap g4">
    <div class="ph" style="height:200px"><img src="/img/gallery-dsc00066.webp" alt="Camper running across the field"></div>
    <div class="ph" style="height:200px"><img src="/img/summer-01.webp" alt="Camper walking across the field"></div>
    <div class="ph" style="height:200px"><img src="/img/home-11.webp" alt="Camper cheering with both arms in the air"></div>
    <div class="ph" style="height:200px"><img src="/img/summer-04.webp" alt="Campers and counselors walking across the field" style="object-position:50% 35%"></div>
  </div></div>
</Layout>
