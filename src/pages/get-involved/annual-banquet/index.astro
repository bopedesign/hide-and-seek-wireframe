import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Annual Banquet | Hide and Seek Day Camp", "description": "An evening to thank the people who give and to hear how camp did last year. There are no tickets.", "path": "/get-involved/annual-banquet/", "banner": {"img": "/img/home-09.webp", "alt": "Campers and counselors posing for a group photo", "eyebrow": "Every spring", "title": "Annual Banquet", "intro": "An evening to thank the people who give and to hear how camp did last year. There are no tickets.", "h1": "title", "crumb": {"href": "/get-involved/", "label": "Get Involved"}}}}>
  <div class="sec" style="padding-bottom:0"><div class="wrap"><div class="row"><span class="gold" style="padding:15px 30px">Save your seat</span><a href="https://www.ultracamp.com/donations/donationselection.aspx?idCamp=307&amp;campCode=hns&amp;idDonationCategory=2574" data-ev="donate_click" target="_blank" rel="noopener" class="ghostD">Give now</a></div></div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px);margin-top:56px"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">What the evening looks like</h2>
    <div class="g3">
      <div class="card"><h3 class="h3">Dinner together</h3><p class="s">A relaxed meal with camp families, staff, and supporters.</p></div>
      <div class="card"><h3 class="h3">Year in review</h3><p class="s">How camp did last summer, told with photos and stories.</p></div>
      <div class="card"><h3 class="h3">What is ahead</h3><p class="s">Requests and plans for the coming year.</p></div>
    </div>
    <p class="s" style="margin-top:20px">No tickets and no silent auction. Giving happens around the banquet, not only during it.</p>
  </div></div>
  <div class="sec"><div class="wrap g3">
    <div class="ph" style="height:260px"><img src="/img/explore-06.webp" alt="Counselors with a group of girls"></div>
    <div class="ph" style="height:260px"><img src="/img/explore-header.webp" alt="Campers and a counselor sitting together indoors"></div>
    <div class="ph" style="height:260px"><img src="/img/summer-header.webp" alt="Campers cheering for the camera" style="object-position:75% 50%"></div>
  </div></div>
</Layout>
