---
import Layout from '../../layouts/Layout.astro';
---
<Layout {...{"title": "Explore Camp | Hide and Seek Day Camp", "description": "Three programs, three campuses, one goal. A safe and loving place to spend the summer outdoors focused around the gospel.", "path": "/explore-camp/", "banner": {"img": "/img/a18.webp", "alt": "Campers heading into the woods", "eyebrow": "Explore Camp", "title": "Find the right week for your camper", "intro": "Three programs, three campuses, one goal. A safe and loving place to spend the summer outdoors focused around the gospel.", "h1": "eyebrow", "crumb": null}}}>
  <div class="sec"><div class="wrap g3">
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/a56.webp" alt="Summer campers"></div><h2 class="h3">Summer Day Camp</h2><p class="s" style="margin-bottom:16px">Finished kindergarten through finished fifth grade, weekly sessions in June and July.</p><div class="row" style="margin-bottom:18px"><span class="chip">$275 per week</span></div><a href="/explore-camp/summer-day-camp/" class="lk">Learn more</a></div>
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/a34.webp" alt="Middle school campers"></div><h2 class="h3">SEEK Adventure</h2><p class="s" style="margin-bottom:16px">One week for finished sixth through eighth grade at Hickory Flat.</p><div class="row" style="margin-bottom:18px"><span class="chip">$300 for the week</span></div><a href="/explore-camp/seek-adventure/" class="lk">Learn more</a></div>
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/a31.webp" alt="Winter camp games"></div><h2 class="h3">Winter Camp</h2><p class="s" style="margin-bottom:16px">Three days in December for families who need a break in the school year.</p><div class="row" style="margin-bottom:18px"><span class="chip">Three days</span></div><a href="/explore-camp/winter-camp/" class="lk">Learn more</a></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap g2">
    <div class="card" style="display:flex;gap:20px;align-items:center"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/a44.webp" alt="A day at camp"></div><div><h2 class="h3">The Camp Experience</h2><p class="s" style="margin-bottom:12px">A day at camp, hour by hour, and every activity on the property.</p><a href="/explore-camp/camp-experience/" class="lk">Learn more</a></div></div>
    <div class="card" style="display:flex;gap:20px;align-items:center"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/a12.webp" alt="Campers with painted faces"></div><div><h2 class="h3">Gallery</h2><p class="s" style="margin-bottom:12px">Photos from past summers at all three campuses.</p><a href="/explore-camp/gallery/" class="lk">Browse photos</a></div></div>
  </div></div>
  <div class="sec"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">Locations</h2>
    <div class="g3">
      <div><div class="ph" style="height:240px"><img src="/img/a02.webp" alt="Hickory Flat"></div><h3 class="h3" style="margin-top:18px">Hickory Flat</h3><p class="s" style="margin-bottom:12px">The largest campus, and home of SEEK Adventure.</p><a href="/locations/hickory-flat/" class="lk">Visit this campus</a></div>
      <div><div class="ph" style="height:240px"><img src="/img/a20.webp" alt="Ball Ground"></div><h3 class="h3" style="margin-top:18px">Ball Ground</h3><p class="s" style="margin-bottom:12px">Mostly woods, with a big outdoor loop and an indoor assembly room.</p><a href="/locations/ball-ground/" class="lk">Visit this campus</a></div>
      <div><div class="ph" style="height:240px"><img src="/img/a04.webp" alt="Sixes"></div><h3 class="h3" style="margin-top:18px">Sixes</h3><p class="s" style="margin-bottom:12px">A large field with some woods and some indoor space.</p><a href="/locations/sixes/" class="lk">Visit this campus</a></div>
    </div>
  </div></div>
</Layout>
