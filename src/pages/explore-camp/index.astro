---
import Layout from '../../layouts/Layout.astro';
---
<Layout {...{"title": "Explore Camp | Hide and Seek Day Camp", "description": "Three programs, three campuses, one goal. A safe and loving place to spend the summer outdoors focused around the gospel.", "path": "/explore-camp/", "banner": {"pos": "30% 25%", "img": "/img/explore-header.webp", "alt": "Campers and a counselor sitting together indoors", "eyebrow": "Explore Camp", "title": "Find the right week for your camper", "intro": "Three programs, three campuses, one goal. A safe and loving place to spend the summer outdoors focused around the gospel.", "h1": "eyebrow", "crumb": null}}}>
  <div class="sec"><div class="wrap g3">
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/explore-01.webp" alt="Camper riding the zipline" style="object-position:50% 30%"></div><h2 class="h3">Summer Day Camp</h2><p class="s" style="margin-bottom:16px">Finished kindergarten through finished fifth grade, weekly sessions in June and July.</p><div class="row" style="margin-bottom:18px"><span class="chip">$275 per week</span></div><a href="/explore-camp/summer-day-camp/" class="lk">Learn more</a></div>
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/explore-02.webp" alt="Campers raising their hands indoors" style="object-position:50% 38%"></div><h2 class="h3">SEEK Adventure</h2><p class="s" style="margin-bottom:16px">One week for finished sixth through eighth grade at Hickory Flat.</p><div class="row" style="margin-bottom:18px"><span class="chip">$300 for the week</span></div><a href="/explore-camp/seek-adventure/" class="lk">Learn more</a></div>
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/explore-03.webp" alt="Camper in a paper crown holding up a drawing" style="object-position:50% 25%"></div><h2 class="h3">Winter Camp</h2><p class="s" style="margin-bottom:16px">A daily camp between Christmas and New Year's for families needing childcare and for campers who miss camp.</p><div class="row" style="margin-bottom:18px"><span class="chip">$55 a day</span></div><a href="/explore-camp/winter-camp/" class="lk">Learn more</a></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap g2">
    <div class="card" style="display:flex;gap:20px;align-items:center"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/explore-04.webp" alt="Campers lined up outside" style="object-position:50% 35%"></div><div><h2 class="h3">The Camp Experience</h2><p class="s" style="margin-bottom:12px">A day at camp, hour by hour, and every activity on the property.</p><a href="/explore-camp/camp-experience/" class="lk">Learn more</a></div></div>
    <div class="card" style="display:flex;gap:20px;align-items:center"><div class="ph" style="height:130px;width:180px;flex:none;border-radius:18px"><img src="/img/explore-05.webp" alt="Two counselors with a group of boys"></div><div><h2 class="h3">Gallery</h2><p class="s" style="margin-bottom:12px">Photos from past summers at all three campuses.</p><a href="/explore-camp/gallery/" class="lk">Browse photos</a></div></div>
  </div></div>
  <div class="sec"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">Locations</h2>
    <div class="g3">
      <div><div class="ph" style="height:240px"><img src="/img/explore-06.webp" alt="Counselors with a group of girls"></div><h3 class="h3" style="margin-top:18px">Hickory Flat</h3><p class="s" style="margin-bottom:12px">Home of SEEK Adventure.</p></div>
      <div><div class="ph" style="height:240px"><img src="/img/explore-07.webp" alt="Two counselors with four campers"></div><h3 class="h3" style="margin-top:18px">Ball Ground</h3><p class="s" style="margin-bottom:12px">Mostly woods, with a big outdoor loop and an indoor assembly room.</p></div>
      <div><div class="ph" style="height:240px"><img src="/img/gallery-mg1531.webp" alt="Campers and counselors gathered on the grass"></div><h3 class="h3" style="margin-top:18px">Sixes</h3><p class="s" style="margin-bottom:12px">A large field with woods and indoor space.</p></div>
    </div>
  </div></div>
</Layout>
