---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Camp Photo Gallery | Hide and Seek Day Camp", "description": "Filter by campus or by event.", "path": "/explore-camp/gallery/", "banner": {"img": "/img/a12.webp", "alt": "Campers with painted faces", "eyebrow": "Gallery", "title": "Photos from past summers", "intro": "Filter by campus or by event.", "h1": "eyebrow", "crumb": {"href": "/explore-camp/", "label": "Explore Camp"}}}}>
  <div class="sec"><div class="wrap">
    <div class="row" style="margin-bottom:36px"><span class="navy" style="padding:11px 22px;font-size:13px">All</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Hickory Flat</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Ball Ground</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Sixes</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Winter Camp</span><span class="ghostD" style="padding:10px 21px;font-size:13px">5K</span></div>
    <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px">
      <div class="ph" style="height:230px;grid-column:span 2"><img src="/img/a51.webp" alt="Zipline"></div>
      <div class="ph" style="height:230px"><img src="/img/a14.webp" alt="Rock wall"></div>
      <div class="ph" style="height:230px"><img src="/img/a22.webp" alt="Slip and slide"></div>
      <div class="ph" style="height:230px"><img src="/img/a05.webp" alt="Zipline"></div>
      <div class="ph" style="height:230px"><img src="/img/a12.webp" alt="Painted faces"></div>
      <div class="ph" style="height:230px;grid-column:span 2"><img src="/img/a48.webp" alt="Climbing wall"></div>
      <div class="ph" style="height:230px"><img src="/img/a18.webp" alt="In the woods"></div>
      <div class="ph" style="height:230px"><img src="/img/a35.webp" alt="Archery"></div>
      <div class="ph" style="height:230px"><img src="/img/a19.webp" alt="Zipline"></div>
      <div class="ph" style="height:230px"><img src="/img/a31.webp" alt="Camp games"></div>
      <div class="ph" style="height:230px;grid-column:span 2"><img src="/img/a21.webp" alt="Slip and slide line"></div>
      <div class="ph" style="height:230px"><img src="/img/a36.webp" alt="Climbing"></div>
      <div class="ph" style="height:230px"><img src="/img/a47.webp" alt="Water games"></div>
      <div class="ph" style="height:230px"><img src="/img/a25.webp" alt="Crate stack"></div>
      <div class="ph" style="height:230px"><img src="/img/a56.webp" alt="Campers"></div>
    </div>
    <div style="display:flex;justify-content:center;margin-top:40px"><span class="ghostD">Load more</span></div>
  </div></div>
</Layout>
