---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Camp Photo Gallery | Hide and Seek Day Camp", "description": "Filter by campus or by event.", "path": "/explore-camp/gallery/", "banner": {"img": "/img/gallery-dsc00345.webp", "alt": "Campers sitting together smiling", "eyebrow": "Gallery", "title": "Photos from past summers", "intro": "Filter by campus or by event.", "h1": "eyebrow", "crumb": {"href": "/explore-camp/", "label": "Explore Camp"}}}}>
  <div class="sec"><div class="wrap">
    <div class="row" style="margin-bottom:36px"><span class="navy" style="padding:11px 22px;font-size:13px">All</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Hickory Flat</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Ball Ground</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Sixes</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Winter Camp</span><span class="ghostD" style="padding:10px 21px;font-size:13px">5K</span></div>
    <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px">
      <div class="ph" style="height:230px;grid-column:span 2"><img src="/img/gallery-dsc00345.webp" alt="Campers sitting together smiling"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-dsc00338.webp" alt="Camper in a harness climbing in the trees"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-mg2424.webp" alt="Camper on a rope swing in the woods"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-dsc00066.webp" alt="Camper running across the field"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-mg2404.webp" alt="Camper making a bead craft"></div>
      <div class="ph" style="height:230px;grid-column:span 2"><img src="/img/gallery-mg1528.webp" alt="Counselor with four campers"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-dsc00087.webp" alt="Camper smiling close to the camera"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-mg5060.webp" alt="Camper smiling at the craft table"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-dsc00067.webp" alt="Campers running and playing on the field"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-mg5116.webp" alt="Camper in a paper crown with a friend"></div>
      <div class="ph" style="height:230px;grid-column:span 2"><img src="/img/summer-11.webp" alt="Camper on the slip and slide"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-dsc09994.webp" alt="Two campers smiling together"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-mg1542.webp" alt="Camper sitting at a picnic table"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-mg5075.webp" alt="Camper smiling during a game"></div>
      <div class="ph" style="height:230px"><img src="/img/gallery-dsc00051.webp" alt="Two campers looking over a wooden rail"></div>
    </div>
    <div style="display:flex;justify-content:center;margin-top:40px"><span class="ghostD">Load more</span></div>
  </div></div>
</Layout>
