---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "The Camp Experience | Hide and Seek Day Camp", "description": "Outdoors most of the day, in small groups, with counselors who care.", "path": "/explore-camp/camp-experience/", "banner": {"img": "/img/week-header.webp", "alt": "Two campers smiling in the woods", "eyebrow": "The camp experience", "title": "What a week actually looks like", "intro": "Outdoors most of the day, in small groups, with counselors who care.", "h1": "eyebrow", "crumb": {"href": "/explore-camp/", "label": "Explore Camp"}}}}>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:start">
    <div><p class="eyebrow">The daily rhythm</p><h2 class="h2">Hour by hour</h2>
      <div style="margin-top:8px">
        <div class="acc" style="border-top-color:#20180f"><p class="s" style="color:#20180f;font-weight:600">7:30 to 9 a.m. &nbsp;Drop off</p></div>
        <div class="acc"><p class="s" style="color:#20180f;font-weight:600">9:15 to 9:45 a.m. &nbsp;Snacks</p></div>
        <div class="acc"><p class="s" style="color:#20180f;font-weight:600">9:45 to 10:15 a.m. &nbsp;Assembly</p></div>
        <div class="acc"><p class="s" style="color:#20180f;font-weight:600">10:15 to 11:45 a.m. &nbsp;Three rotations</p><p class="s" style="margin-top:4px">Curriculum, arts and crafts, field games, gaga ball, and free choice</p></div>
        <div class="acc"><p class="s" style="color:#20180f;font-weight:600">11:45 a.m. to 12:15 p.m. &nbsp;Lunch</p></div>
        <div class="acc"><p class="s" style="color:#20180f;font-weight:600">12:15 to 2:45 p.m. &nbsp;Four to five rotations</p></div>
        <div class="acc"><p class="s" style="color:#20180f;font-weight:600">2:45 to 3 p.m. &nbsp;Carpool</p></div>
        <div class="acc" style="border-bottom:1px solid #e2d9c6"><p class="s" style="color:#20180f;font-weight:600">3 to 6 p.m. &nbsp;Late pick up</p></div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px">
      <div class="ph" style="height:220px"><img src="/img/week-01.webp" alt="Counselors with a group of campers" style="object-position:50% 40%"></div>
      <div class="ph" style="height:220px;margin-top:30px"><img src="/img/week-02.webp" alt="Camper playing on a stick fort"></div>
      <div class="ph" style="height:220px"><img src="/img/week-03.webp" alt="Camper drawing at a table" style="object-position:50% 20%"></div>
      <div class="ph" style="height:220px;margin-top:30px"><img src="/img/week-04.webp" alt="Camper smiling with friends in the woods" style="object-position:50% 40%"></div>
    </div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">Every activity on the property</h2>
    <div class="g4">
      <div class="card"><h3 class="h3" style="margin:0">Zipline</h3></div><div class="card"><h3 class="h3" style="margin:0">Gaga ball</h3></div><div class="card"><h3 class="h3" style="margin:0">Rock wall</h3></div><div class="card"><h3 class="h3" style="margin:0">Crate stack</h3></div>
      <div class="card"><h3 class="h3" style="margin:0">Ninja island low ropes</h3></div><div class="card"><h3 class="h3" style="margin:0">Arts and crafts</h3></div><div class="card"><h3 class="h3" style="margin:0">Bracelet making</h3></div><div class="card"><h3 class="h3" style="margin:0">9 square and field games</h3></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:center">
    <div class="ph" style="height:380px"><img src="/img/week-05.webp" alt="Camper soaked and smiling on water day"></div>
    <div><p class="eyebrow">Two days everyone waits for</p><h2 class="h2">Thursday is water day</h2><p class="p">Slip and slide, relay races, and water games. Send a towel and a change of clothes.</p><h2 class="h2" style="margin-top:32px">Friday is open woods</h2><p class="p">Free reign of the outdoor activities to close out the week.</p></div>
  </div></div>
  <div class="navyband" style="padding:88px clamp(20px,3vw,40px);border-radius:36px 36px 0 0"><div class="wrap g2" style="gap:56px;align-items:center">
    <div><p class="eyebrow" style="color:#dda527">Bible teaching</p><h2 class="h2" style="color:#fff">Not confined to one rotation</h2><p class="p" style="color:rgba(255,255,255,.86)">Curriculum is one of the rotations, but the teaching is not confined to it. Counselors talk about the attributes of God on walks around camp and campers memorize scripture that flows from the week's lesson.</p></div>
    <div class="ph" style="height:320px"><img src="/img/gallery-dsc00117.webp" alt="Campers and counselors posing on the pavement" style="object-position:50% 40%"></div>
  </div></div>
</Layout>
