<Layout {...{"title": "Winter Camp | Hide and Seek Day Camp", "description": "A daily camp between Christmas and New Year's for families needing childcare and for campers who miss camp. Same staff, same games, colder woods.", "path": "/explore-camp/winter-camp/", "banner": {"img": "/img/a27.webp", "alt": "Winter camp activities", "eyebrow": "Three days in December", "title": "Winter Camp", "intro": "A daily camp between Christmas and New Year's for families needing childcare and for campers who miss camp. Campers for Winter Camp must currently be attending kindergarten through fifth grade. Same staff, same games, colder woods.", "h1": "title", "crumb": {"href": "/explore-camp/", "label": "Explore Camp"}}}}>
  <div class="sec" style="padding-bottom:0"><div class="wrap g4">
    <div class="card"><p class="eyebrow" style="margin-bottom:8px">Dates</p><p class="s">December 29, 30,&nbsp;31</p></div>
    <div class="card"><p class="eyebrow" style="margin-bottom:8px">Hours</p><p class="s">9&nbsp;a.m. to 3&nbsp;p.m., with early drop off at 7:30&nbsp;a.m. and late pick up until 6&nbsp;p.m.</p></div>
