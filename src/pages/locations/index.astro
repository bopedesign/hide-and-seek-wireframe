---
import Layout from '../../layouts/Layout.astro';
---
<Layout {...{"title": "Camp Locations | Hide and Seek Day Camp", "description": "All three are hosted on church property. Pick the one closest to you.", "path": "/locations/", "banner": {"img": "/img/campus-mg1652.webp", "alt": "Two campers jumping", "eyebrow": "Locations", "title": "Three campuses across Cherokee County", "intro": "All three are hosted on church property. Pick the one closest to you.", "h1": "eyebrow", "crumb": {"href": "/explore-camp/", "label": "Explore Camp"}}}}>
  <div class="sec"><div class="wrap g3">
    <div class="card"><div class="ph" style="height:210px;margin-bottom:20px"><img src="/img/campus-mg1466.webp" alt="Camper holding a ball"></div><h2 class="h3">Hickory Flat</h2><p class="s" style="margin-bottom:12px">Mt. Zion Baptist Church<br>4096 East Cherokee Drive<br>Canton, GA 30115</p><p class="s" style="margin-bottom:16px">Huge field, wooded area, and indoor space. The largest campus.</p><a href="/locations/hickory-flat/" class="lk">Location details</a></div>
    <div class="card"><div class="ph" style="height:210px;margin-bottom:20px"><img src="/img/campus-mg1848.webp" alt="Camper standing on the crate stack"></div><h2 class="h3">Ball Ground</h2><p class="s" style="margin-bottom:12px">Ball Ground Methodist Church<br>3045 Canton Hwy<br>Ball Ground, GA 30107</p><p class="s" style="margin-bottom:16px">A big outdoor loop in the woods, a small field, and a large indoor assembly room.</p><a href="/locations/ball-ground/" class="lk">Location details</a></div>
    <div class="card"><div class="ph" style="height:210px;margin-bottom:20px"><img src="/img/campus-mg5088.webp" alt="Two campers at a wooden wall"></div><h2 class="h3">Sixes</h2><p class="s" style="margin-bottom:12px">8385 Bells Ferry Road<br>Canton, GA 30114</p><p class="s" style="margin-bottom:16px">A large field with some woods and some indoor space.</p><a href="/locations/sixes/" class="lk">Location details</a></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:28px">Find your campus</h2>
    <div class="ph" style="height:380px;background:#e4eef7;display:flex;align-items:center;justify-content:center"><p class="s" style="font-weight:600;color:#245b83">Interactive map, three pins across Cherokee County</p></div>
  </div></div>
</Layout>
