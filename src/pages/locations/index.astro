---
import Layout from '../../layouts/Layout.astro';
---
<Layout {...{"title": "Camp Locations | Hide and Seek Day Camp", "description": "All three are hosted on church property. Pick the one closest to you.", "path": "/locations/", "banner": {"pos": "50% 15%", "img": "/img/campus-mg1652.webp", "alt": "Two campers jumping", "eyebrow": "Locations", "title": "Three campuses across Cherokee County", "intro": "All three are hosted on church property. Pick the one closest to you.", "h1": "eyebrow", "crumb": {"href": "/explore-camp/", "label": "Explore Camp"}}}}>
  <div class="sec"><div class="wrap g3">
    <div class="card"><div class="ph" style="height:210px;margin-bottom:20px"><img src="/img/campus-mg1466.webp" alt="Camper holding a ball" style="object-position:50% 45%"></div><h2 class="h3">Hickory Flat</h2><p class="s" style="margin-bottom:12px">Mt. Zion Baptist Church<br>4096 East Cherokee Drive<br>Canton, GA 30115</p><p class="s" style="margin-bottom:16px">Huge field, wooded area, and indoor space. The largest campus.</p><a href="/locations/hickory-flat/" class="lk">Location details</a></div>
    <div class="card"><div class="ph" style="height:210px;margin-bottom:20px"><img src="/img/campus-mg1848.webp" alt="Camper standing on the crate stack" style="object-position:50% 35%"></div><h2 class="h3">Ball Ground</h2><p class="s" style="margin-bottom:12px">Ball Ground Methodist Church<br>3045 Canton Hwy<br>Ball Ground, GA 30107</p><p class="s" style="margin-bottom:16px">A big outdoor loop in the woods, a small field, and a large indoor assembly room.</p><a href="/locations/ball-ground/" class="lk">Location details</a></div>
    <div class="card"><div class="ph" style="height:210px;margin-bottom:20px"><img src="/img/campus-mg5088.webp" alt="Two campers at a wooden wall" style="object-position:50% 30%"></div><h2 class="h3">Sixes</h2><p class="s" style="margin-bottom:12px">8385 Bells Ferry Road<br>Canton, GA 30114</p><p class="s" style="margin-bottom:16px">A large field with some woods and some indoor space.</p><a href="/locations/sixes/" class="lk">Location details</a></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:28px">Find your campus</h2>
    <div id="campus-map" style="height:380px;background:#e4eef7;border-radius:22px;overflow:hidden;position:relative;z-index:0" role="region" aria-label="Map of the three camp campuses"></div>
  </div></div>
</Layout>
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // Pins for the three campuses. Coordinates come from each church's street address.
  const campuses = [
    { name: 'Hickory Flat', place: 'Mt. Zion Baptist Church', address: '4096 East Cherokee Drive, Canton, GA 30115', at: [34.19085, -84.42248] },
    { name: 'Ball Ground', place: 'Ball Ground Methodist Church', address: '3045 Canton Hwy, Ball Ground, GA 30107', at: [34.34515, -84.38177] },
    { name: 'Sixes', place: '', address: '8385 Bells Ferry Road, Canton, GA 30114', at: [34.17277, -84.56110] },
  ];

  const map = L.map('campus-map', { scrollWheelZoom: false });
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  }).addTo(map);

  const pin = L.divIcon({ className: 'campus-pin', html: '<span></span>', iconSize: [22, 22], iconAnchor: [11, 11], popupAnchor: [0, -12] });
  for (const c of campuses) {
    const directions = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(c.address);
    L.marker(c.at, { icon: pin, title: c.name, alt: c.name + ' campus' }).addTo(map).bindPopup(
      `<strong>${c.name}</strong><br>${c.place ? c.place + '<br>' : ''}${c.address}<br>` +
      `<a href="${directions}" data-ev="directions_click" target="_blank" rel="noopener">Get directions</a>`
    );
  }
  map.fitBounds(L.latLngBounds(campuses.map((c) => c.at)), { padding: [40, 40] });
</script>
<style is:global>
  .campus-pin span { display:block; width:22px; height:22px; border-radius:999px; background:#245b83; border:3px solid #fff; box-shadow:0 2px 6px rgba(0,0,0,.35) }
  #campus-map .leaflet-popup-content { font-size:14px; line-height:1.5 }
  #campus-map img { max-width:none !important; max-height:none !important; border-radius:0 }
</style>
