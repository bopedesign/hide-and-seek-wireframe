---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Ball Ground Campus | Hide and Seek Day Camp", "description": "Hosted by Ball Ground Methodist Church, mostly woods.", "path": "/locations/ball-ground/", "banner": {"pos": "50% 20%", "img": "/img/campus-extra.webp", "alt": "Camper smiling for the camera", "eyebrow": "Location", "title": "Ball Ground", "intro": "Hosted by Ball Ground Methodist Church, mostly woods.", "h1": "title", "crumb": {"href": "/locations/", "label": "Locations"}}}}>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:start">
    <div><p class="eyebrow">Mostly woods</p><h2 class="h2">A big outdoor loop under the trees</h2><p class="p">Hosted by Ball Ground Methodist Church. Mostly woods, with a big outdoor loop, a small field, and a large indoor assembly room.</p><div class="row" style="margin-top:20px"><a href="https://www.ultracamp.com/clientlogin.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="register_click" target="_blank" rel="noopener" class="gold">Register at Ball Ground</a></div></div>
    <div class="card"><p class="eyebrow" style="margin-bottom:6px">Address</p><p class="s" style="margin-bottom:18px">3045 Canton Hwy, Ball Ground, GA 30107</p><p class="eyebrow" style="margin-bottom:6px">Programs here</p><p class="s" style="margin-bottom:18px">Summer Day Camp</p><p class="eyebrow" style="margin-bottom:6px">Hours</p><p class="s">9 a.m. to 3 p.m., early drop off 7:30 a.m., post camp until 6 p.m.</p></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:28px">Drop off and pick up</h2>
    <div class="g2">
      <div class="card"><h3 class="h3">Normal drop off</h3><p class="s">Directions to be supplied by camp staff.</p></div>
      <div class="card"><h3 class="h3">Rainy day drop off</h3><p class="s">Directions to be supplied by camp staff.</p></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap g3">
    <div class="ph" style="height:250px"><img src="/img/a26.webp" alt="The loop trail"></div>
    <div class="ph" style="height:250px"><img src="/img/a04.webp" alt="The field"></div>
    <div class="ph" style="height:250px"><img src="/img/a42.webp" alt="Assembly room"></div>
  </div></div>
</Layout>
