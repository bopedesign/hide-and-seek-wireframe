---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Hickory Flat Campus | Hide and Seek Day Camp", "description": "Our largest campus, hosted by Mt. Zion Baptist Church.", "path": "/locations/hickory-flat/", "banner": {"pos": "50% 39%", "img": "/img/campus-mg1487.webp", "alt": "Camper in a helmet smiling", "eyebrow": "Location", "title": "Hickory Flat", "intro": "Our largest campus, hosted by Mt. Zion Baptist Church.", "h1": "title", "crumb": {"href": "/locations/", "label": "Locations"}}}}>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:start">
    <div><p class="eyebrow">The largest campus</p><h2 class="h2">Field, woods, and the full ropes course</h2><p class="p">Hosted by Mt. Zion Baptist Church. A huge field with a wooded area and indoor space for rainy days. Home of SEEK Adventure and the Hickory FlatOut 5K.</p><div class="row" style="margin-top:20px"><a href="https://www.ultracamp.com/clientlogin.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="register_click" target="_blank" rel="noopener" class="gold">Register at Hickory Flat</a></div></div>
    <div class="card"><p class="eyebrow" style="margin-bottom:6px">Address</p><p class="s" style="margin-bottom:18px">4096 East Cherokee Drive, Canton, GA 30115</p><p class="eyebrow" style="margin-bottom:6px">Programs here</p><p class="s" style="margin-bottom:18px">Summer Day Camp, SEEK Adventure, Winter Camp</p><p class="eyebrow" style="margin-bottom:6px">Hours</p><p class="s">9 a.m. to 3 p.m., early drop off 7:30 a.m., post camp until 6 p.m.</p></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:28px">Drop off and pick up</h2>
    <div class="g2">
      <div class="card"><h3 class="h3">Normal drop off</h3><p class="s">Located behind the main church, in the back parking lot near the overhang. Enter by the main entrance with the digital sign and drive behind the gym.</p></div>
      <div class="card"><h3 class="h3">Rainy day drop off</h3><p class="s">Moves inside the chapel, accessed via the side door. Enter by the main entrance with the digital sign, drive behind the main church building, and take the small driveway up on the right.</p></div>
      <div class="card"><h3 class="h3">Pick up</h3><p class="s">The line begins at the side door of the chapel and wraps around the back. A staff member will approach your car and call for your camper.</p></div>
      <div class="card"><h3 class="h3">Carpool rules</h3><p class="s">Please move all the way up the line. Only those on your camper's pick up list may collect your child. Cell phone use is not permitted in the carpool line.</p></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap g3">
    <div class="ph" style="height:250px"><img src="/img/a26.webp" alt="The woods"></div>
    <div class="ph" style="height:250px"><img src="/img/a48.webp" alt="The ropes course"></div>
    <div class="ph" style="height:250px"><img src="/img/a24.webp" alt="Indoor space"></div>
  </div></div>
</Layout>
