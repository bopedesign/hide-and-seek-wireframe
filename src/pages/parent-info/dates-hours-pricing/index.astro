---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Dates, Hours and Pricing | Hide and Seek Day Camp", "description": "Registration opens March 1. Price is organized by the session, and you can register for as many sessions as you like.", "path": "/parent-info/dates-hours-pricing/", "banner": {"pos": "45% 35%", "img": "/img/parent-03.webp", "alt": "Campers goofing around in silly glasses", "eyebrow": "Parent Info", "title": "Dates, Hours & Pricing", "intro": "Registration opens March 1. Price is organized by the session, and you can register for as many sessions as you like.", "h1": "title", "crumb": {"href": "/parent-info/", "label": "Parent Info"}}}}>
  <div class="sec"><div class="wrap">
    <p class="eyebrow">Pricing</p><h2 class="h2" style="margin-bottom:32px">Priced by the session</h2>
    <div class="g4">
      <div class="card"><h3 class="h3">Day Camp</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$275</p><p class="s">per week, 9 a.m. to 3 p.m.</p></div>
      <div class="card"><h3 class="h3">Early drop off</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$15</p><p class="s">per week, begins at 7:30 a.m.</p></div>
      <div class="card"><h3 class="h3">Post camp</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$30</p><p class="s">per week, 3 p.m. to 6 p.m.</p></div>
      <div class="card"><h3 class="h3">SEEK Adventure</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$300</p><p class="s">for the week, 9 a.m. to 4 p.m.</p></div>
    </div>
    <p class="s" style="margin-top:20px">SEEK Adventure has no early drop off or post camp.</p>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:24px">Session dates</h2>
    <div class="row" role="tablist" aria-label="Campus" style="margin-bottom:24px"><button type="button" role="tab" id="tab-hickory-flat" aria-controls="dates-hickory-flat" aria-selected="true" class="navy" style="font:inherit;font-size:13px;padding:10px 21px;border:1.5px solid #245b83">Hickory Flat</button><button type="button" role="tab" id="tab-ball-ground" aria-controls="dates-ball-ground" aria-selected="false" class="ghostD" style="font:inherit;font-size:13px;padding:10px 21px;border:1.5px solid #20180f">Ball Ground</button><button type="button" role="tab" id="tab-sixes" aria-controls="dates-sixes" aria-selected="false" class="ghostD" style="font:inherit;font-size:13px;padding:10px 21px;border:1.5px solid #20180f">Sixes</button></div>
    <div role="tabpanel" id="dates-hickory-flat" aria-labelledby="tab-hickory-flat">
      <div style="background:#fff;border-radius:24px;overflow:hidden">
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;background:#245b83;color:#fff;font-size:12.5px;font-weight:600;padding:16px 24px"><span>Session</span><span>Dates</span><span>Notes</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>1</span><span>May 27 to May 30</span><span style="color:#5c5348">Four day week</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>2</span><span>June 2 to June 6</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>3</span><span>June 9 to June 13</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>4</span><span>June 16 to June 20</span><span style="color:#5c5348">No post camp</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>5</span><span>June 23 to June 27</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db;color:#a3968a"><span></span><span>June 30 to July 3</span><span>No camp</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>6</span><span>July 7 to July 11</span><span style="color:#5c5348">SEEK Adventure, middle school only</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px"><span>7</span><span>July 14 to July 18</span><span></span></div>
      </div>
    </div>
    <div role="tabpanel" id="dates-ball-ground" aria-labelledby="tab-ball-ground" hidden>
      <div style="background:#fff;border-radius:24px;overflow:hidden">
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;background:#245b83;color:#fff;font-size:12.5px;font-weight:600;padding:16px 24px"><span>Session</span><span>Dates</span><span>Notes</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>1</span><span>May 27 to May 30</span><span style="color:#5c5348">Four day week</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>2</span><span>June 2 to June 6</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>3</span><span>June 9 to June 13</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>4</span><span>June 16 to June 20</span><span style="color:#5c5348">No post camp</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>5</span><span>June 23 to June 27</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db;color:#a3968a"><span></span><span>June 30 to July 3</span><span>No camp</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>6</span><span>July 7 to July 11</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px"><span>7</span><span>July 14 to July 18</span><span></span></div>
      </div>
    </div>
    <div role="tabpanel" id="dates-sixes" aria-labelledby="tab-sixes" hidden>
      <div style="background:#fff;border-radius:24px;overflow:hidden">
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;background:#245b83;color:#fff;font-size:12.5px;font-weight:600;padding:16px 24px"><span>Session</span><span>Dates</span><span>Notes</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>1</span><span>May 27 to May 30</span><span style="color:#5c5348">Four day week</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>2</span><span>June 2 to June 6</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>3</span><span>June 9 to June 13</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>4</span><span>June 16 to June 20</span><span style="color:#5c5348">No post camp</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>5</span><span>June 23 to June 27</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db;color:#a3968a"><span></span><span>June 30 to July 3</span><span>No camp</span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>6</span><span>July 7 to July 11</span><span></span></div>
        <div style="display:grid;grid-template-columns:1fr 2fr 2fr;font-size:14px;padding:16px 24px"><span>7</span><span>July 14 to July 18</span><span></span></div>
      </div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:center">
    <div><p class="eyebrow">Daily hours</p><h2 class="h2">Built around a working day</h2><p class="s" style="font-size:15px;line-height:1.9">Early drop off begins 7:30 a.m.<br>Camp runs 9 a.m. to 3 p.m.<br>Post camp runs until 6 p.m.<br>Lunch is packed and brought from home.</p></div>
    <div class="ph" style="height:320px"><img src="/img/summer-04.webp" alt="Campers and counselors walking across the field" style="object-position:50% 30%"></div>
  </div></div>
  <div class="sec" style="padding-top:0"><div class="wrap">
    <div style="position:relative;border-radius:32px;overflow:hidden;padding:72px 56px;display:flex;align-items:center">
      <img src="/img/gallery-mg1531.webp" alt="Campers and counselors gathered on the grass" style="object-position:50% 45%;position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(36,91,131,.95) 0%,rgba(36,91,131,.8) 55%,rgba(36,91,131,.4) 100%)"></div>
      <div style="position:relative;max-width:560px"><h2 class="h2" style="color:#fff">Register on UltraCamp</h2><p class="p" style="color:rgba(255,255,255,.88);margin-bottom:28px">Cost should not keep a camper home. Scholarships are available at every campus.</p><div class="row"><a href="https://www.ultracamp.com/clientlogin.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="register_click" target="_blank" rel="noopener" class="gold">Register</a><a href="/parent-info/scholarships/" class="ghostL">Scholarships</a></div></div>
    </div>
  </div></div>
</Layout>
<script>
  // Campus buttons above the session dates: show the chosen campus's list.
  const tabs = document.querySelectorAll('[role="tab"][aria-controls^="dates-"]');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.className = on ? 'navy' : 'ghostD';
      t.style.borderColor = on ? '#245b83' : '#20180f';
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
  }));
</script>
