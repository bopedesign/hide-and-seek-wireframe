---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Dates, Hours and Pricing | Hide and Seek Day Camp", "description": "Registration opens March 1. Price is organized by the session, and you can register for as many sessions as you like.", "path": "/parent-info/dates-hours-pricing/", "banner": {"img": "/img/a13.webp", "alt": "A camper at camp", "eyebrow": "Parent Info", "title": "Dates, Hours & Pricing", "intro": "Registration opens March 1. Price is organized by the session, and you can register for as many sessions as you like.", "h1": "title", "crumb": {"href": "/parent-info/", "label": "Parent Info"}}}}>
  <div class="sec"><div class="wrap">
    <p class="eyebrow">Pricing</p><h2 class="h2" style="margin-bottom:32px">Priced by the session</h2>
    <div class="g4">
      <div class="card"><h3 class="h3">Day Camp</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$275</p><p class="s">per week, 9 a.m. to 3 p.m.</p></div>
      <div class="card"><h3 class="h3">Early drop off</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$15</p><p class="s">per week, begins at 7:30 a.m.</p></div>
      <div class="card"><h3 class="h3">Post camp</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$30</p><p class="s">per week, 3 p.m. to 6 p.m.</p></div>
      <div class="card"><h3 class="h3">SEEK Adventure</h3><p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.03em">$300</p><p class="s">for the week, 9 a.m. to 4 p.m.</p></div>
    </div>
    <p class="s" style="margin-top:20px">SEEK Adventure has no early drop off or post camp.</p>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2" style="margin-bottom:24px">Session dates</h2>
    <div class="row" style="margin-bottom:24px"><span class="navy" style="padding:11px 22px;font-size:13px">Hickory Flat</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Ball Ground</span><span class="ghostD" style="padding:10px 21px;font-size:13px">Sixes</span></div>
    <div style="background:#fff;border-radius:24px;overflow:hidden">
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;background:#245b83;color:#fff;font-size:12.5px;font-weight:600;padding:16px 24px"><span>Session</span><span>Dates</span><span>Notes</span><span>Status</span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>1</span><span>May 27 to May 30</span><span style="color:#5c5348">Four day week</span><span style="color:#7a8a5e;font-weight:600">Open</span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>2</span><span>June 2 to June 6</span><span></span><span style="color:#7a8a5e;font-weight:600">Open</span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>3</span><span>June 9 to June 13</span><span></span><span style="color:#c8901b;font-weight:600">Filling</span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>4</span><span>June 16 to June 20</span><span style="color:#5c5348">No post camp</span><span style="color:#a3968a;font-weight:600">Full</span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>5</span><span>June 23 to June 27</span><span></span><span style="color:#7a8a5e;font-weight:600">Open</span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db;color:#a3968a"><span></span><span>June 30 to July 3</span><span>No camp</span><span></span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px;border-bottom:1px solid #f0e9db"><span>6</span><span>July 7 to July 11</span><span style="color:#5c5348">SEEK Adventure, middle school only</span><span style="color:#7a8a5e;font-weight:600">Open</span></div>
      <div style="display:grid;grid-template-columns:1fr 2fr 2fr 1fr;font-size:14px;padding:16px 24px"><span>7</span><span>July 14 to July 18</span><span></span><span style="color:#7a8a5e;font-weight:600">Open</span></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:center">
    <div><p class="eyebrow">Daily hours</p><h2 class="h2">Built around a working day</h2><p class="s" style="font-size:15px;line-height:1.9">Early drop off begins 7:30 a.m.<br>Camp runs 9 a.m. to 3 p.m.<br>Post camp runs until 6 p.m.<br>Lunch is packed and brought from home.</p></div>
    <div class="ph" style="height:320px"><img src="/img/a23.webp" alt="Campers at pick up"></div>
  </div></div>
  <div class="sec" style="padding-top:0"><div class="wrap">
    <div style="position:relative;border-radius:32px;overflow:hidden;padding:72px 56px;display:flex;align-items:center">
      <img src="/img/a56.webp" alt="Campers" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(36,91,131,.95) 0%,rgba(36,91,131,.8) 55%,rgba(36,91,131,.4) 100%)"></div>
      <div style="position:relative;max-width:560px"><h2 class="h2" style="color:#fff">Register on UltraCamp</h2><p class="p" style="color:rgba(255,255,255,.88);margin-bottom:28px">Cost should not keep a camper home. Scholarships are available at every campus.</p><div class="row"><a href="https://www.ultracamp.com/clientlogin.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="register_click" target="_blank" rel="noopener" class="gold">Register</a><a href="/parent-info/scholarships/" class="ghostL">Scholarships</a></div></div>
    </div>
  </div></div>
</Layout>
