---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Camp Scholarships | Hide and Seek Day Camp", "description": "Cost should never be the reason a child misses camp. Scholarships are available at every campus.", "path": "/parent-info/scholarships/", "banner": {"pos": "50% 30%", "img": "/img/explore-06.webp", "alt": "Counselors with a group of girls", "eyebrow": "Parent Info", "title": "Scholarships", "intro": "Cost should never be the reason a child misses camp. Scholarships are available at every campus.", "h1": "title", "crumb": {"href": "/parent-info/", "label": "Parent Info"}}}}>
  <div class="sec" style="padding-bottom:0"><div class="wrap"><div class="row"><a href="https://docs.google.com/forms/d/e/1FAIpQLSfBRBBOD3-lr92C_Meqxd14hgy6BXoeE3-bsOxP9CjAPpA04w/viewform" data-ev="scholarship_click" target="_blank" rel="noopener" class="gold" style="padding:15px 30px">Start the application</a></div><p class="s" style="margin-top:12px">Opens the external application in a new tab.</p></div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px);margin-top:56px"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">How it works</h2>
    <div class="g4">
      <div class="card"><p class="eyebrow" style="margin-bottom:10px">Step one</p><h3 class="h3">Apply</h3><p class="s">Fill out the short application with your family details.</p></div>
      <div class="card"><p class="eyebrow" style="margin-bottom:10px">Step two</p><h3 class="h3">We review</h3><p class="s">The camp office reviews every request privately.</p></div>
      <div class="card"><p class="eyebrow" style="margin-bottom:10px">Step three</p><h3 class="h3">We respond</h3><p class="s">You hear back with the amount awarded.</p></div>
      <div class="card"><p class="eyebrow" style="margin-bottom:10px">Step four</p><h3 class="h3">Register</h3><p class="s">Reserve your weeks with the award applied.</p></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap g2" style="gap:56px;align-items:center">
    <div><p class="eyebrow">Questions about paying</p><h2 class="h2">Ask the office, quietly</h2><p class="p">The camp office handles every scholarship request privately. Call or write and ask.</p><a href="/contact/" class="lk">Contact the camp office</a></div>
    <div class="ph" style="height:320px"><img src="/img/explore-07.webp" alt="Two counselors with four campers"></div>
  </div></div>
</Layout>
