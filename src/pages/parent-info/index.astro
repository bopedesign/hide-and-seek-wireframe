---
import Layout from '../../layouts/Layout.astro';
---
<Layout {...{"title": "Parent Info | Hide and Seek Day Camp", "description": "Dates, pricing, safety, packing, and financial help, all in one place.", "path": "/parent-info/", "banner": {"pos": "45% 20%", "img": "/img/parent-header.webp", "alt": "Counselor with a group of boys in the woods", "eyebrow": "Parent Info", "title": "Everything you need before the first morning", "intro": "Dates, pricing, safety, packing, and financial help, all in one place.", "h1": "eyebrow", "crumb": null}}}>
  <div class="sec"><div class="wrap g2">
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:120px;width:170px;flex:none;border-radius:18px"><img src="/img/parent-01.webp" alt="Camper on a wooden walkway"></div><div><h2 class="h3">Dates, Hours &amp; Pricing</h2><p class="s" style="margin-bottom:12px">Session dates by campus, daily hours, and what each week costs.</p><a href="/parent-info/dates-hours-pricing/" class="lk">Open</a></div></div>
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:120px;width:170px;flex:none;border-radius:18px"><img src="/img/parent-02.webp" alt="Camper in a helmet on the climbing wall" style="object-position:50% 25%"></div><div><h2 class="h3">Safety</h2><p class="s" style="margin-bottom:12px">Staff screening, training, and how we run the ropes course.</p><a href="/parent-info/safety/" class="lk">Open</a></div></div>
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:120px;width:170px;flex:none;border-radius:18px"><img src="/img/parent-03.webp" alt="Campers goofing around in silly glasses"></div><div><h2 class="h3">Parent Guide &amp; FAQs</h2><p class="s" style="margin-bottom:12px">What to pack, drop off, lunches, and the questions we hear most.</p><a href="/parent-info/faqs/" class="lk">Open</a></div></div>
    <div class="card" style="display:flex;gap:20px"><div class="ph" style="height:120px;width:170px;flex:none;border-radius:18px"><img src="/img/parent-04.webp" alt="Counselor with four campers"></div><div><h2 class="h3">Scholarships</h2><p class="s" style="margin-bottom:12px">Financial help so cost does not keep a child home.</p><a href="/parent-info/scholarships/" class="lk">Open</a></div></div>
  </div></div>
  <div class="navyband" style="padding:60px clamp(20px,3vw,40px);border-radius:36px 36px 0 0"><div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
    <h2 class="h2" style="color:#fff;margin:0">Still have a question?</h2><a href="/contact/" class="gold">Contact the camp office</a>
  </div></div>
</Layout>
