    <div><p style="margin:0 0 6px;font-size:44px;font-weight:600;letter-spacing:-.03em;line-height:1">3</p><p class="s">campuses in Cherokee County</p></div>
    <div><p style="margin:0 0 6px;font-size:44px;font-weight:600;letter-spacing:-.03em;line-height:1">6</p><p class="s">weeks of finished K to finished 5th grade camp</p></div>
    <div><p style="margin:0 0 6px;font-size:44px;font-weight:600;letter-spacing:-.03em;line-height:1">1</p><p class="s">week of middle school camp</p></div>
  </div></div>
</Layout>
