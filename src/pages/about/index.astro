<Layout {...{"title": "About Hide and Seek | Hide and Seek Day Camp", "description": "A Christ saturated program for school aged children, run by Seek Ministries. This is our 18th summer.", "path": "/about/", "banner": {"pos": "50% 40%", "img": "/img/about-01.webp", "alt": "The whole camp together for a group photo", "eyebrow": "About", "title": "About Hide and Seek", "intro": "A Christ saturated program for school aged children, run by Seek Ministries. This is our 18th summer.", "h1": "title", "crumb": null}}}>
  <div class="sec"><div class="wrap g2">
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/about-header.webp" alt="Camper with a big smile" style="object-position:50% 15%"></div><h2 class="h3">Seek Ministries</h2><p class="s" style="margin-bottom:16px">The non profit behind the camp and the fundraisers.</p><a href="/about/seek-ministries/" class="lk">Learn more</a></div>
    <div class="card"><div class="ph" style="height:190px;margin-bottom:20px"><img src="/img/about-02.webp" alt="Counselors and a camper sitting together in the woods"></div><h2 class="h3">Mission &amp; Story</h2><p class="s" style="margin-bottom:16px">Where the name came from and why camp exists.</p><a href="/about/mission/" class="lk">Learn more</a></div>
