---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Seek Ministries | Hide and Seek Day Camp", "description": "Seek Ministries is the non profit behind Hide and Seek Day Camp. Camp is the largest thing we do, and it is not the only thing.", "path": "/about/seek-ministries/", "banner": {"img": "/img/involved-header.webp", "alt": "The whole camp together for a group photo", "eyebrow": "Seek Ministries", "title": "To create environments to show the supremacy of God", "intro": "Seek Ministries is the non profit behind Hide and Seek Day Camp. Camp is the largest thing we do, and it is not the only thing.", "h1": "eyebrow", "crumb": {"href": "/about/", "label": "About"}}}}>
  <div class="sec"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">What Seek Ministries runs</h2>
    <div class="g3">
      <div class="card"><div class="ph" style="height:200px;margin-bottom:20px"><img src="/img/summer-header.webp" alt="Campers cheering for the camera" style="object-position:70% 35%"></div><h3 class="h3">Hide and Seek Day Camp</h3><p class="s" style="margin-bottom:16px">Summer, SEEK Adventure, and Winter Camp across three campuses.</p><a href="/explore-camp/" class="lk">Explore camp</a></div>
      <div class="card"><div class="ph" style="height:200px;margin-bottom:20px"><img src="/img/gallery-dsc00066.webp" alt="Camper running across the field"></div><h3 class="h3">Hickory FlatOut 5K</h3><p class="s" style="margin-bottom:16px">A Labor Day morning race and kids fun run that funds camp.</p><a href="/get-involved/hickory-flatout-5k/" class="lk">Race details</a></div>
      <div class="card"><div class="ph" style="height:200px;margin-bottom:20px"><img src="/img/about-02.webp" alt="Counselors and a camper sitting together in the woods"></div><h3 class="h3">Annual Banquet</h3><p class="s" style="margin-bottom:16px">A spring gathering to thank the people who give.</p><a href="/get-involved/annual-banquet/" class="lk">Banquet details</a></div>
    </div>
  </div></div>
  <div class="sec" style="padding-top:0"><div class="wrap">
    <div style="position:relative;border-radius:32px;overflow:hidden;padding:72px 56px;display:flex;align-items:center">
      <img src="/img/home-header-2.webp" alt="The whole camp together for a group photo" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(36,91,131,.95) 0%,rgba(36,91,131,.82) 52%,rgba(36,91,131,.44) 100%)"></div>
      <div style="position:relative;max-width:560px"><h2 class="h2" style="color:#fff">Support the ministry</h2><p class="p" style="color:rgba(255,255,255,.88);margin-bottom:28px">Gifts send kids to camp and keep the property running.</p><div class="row"><a href="https://www.ultracamp.com/donations/donationselection.aspx?idCamp=307&amp;campCode=hns&amp;idDonationCategory=2574" data-ev="donate_click" target="_blank" rel="noopener" class="gold">Donate</a></div></div>
    </div>
  </div></div>
</Layout>
