---
import Layout from '../../../layouts/Layout.astro';
---
<Layout {...{"title": "Mission and Story | Hide and Seek Day Camp", "description": "Camp exists so kids have a safe and loving place to spend their summer outdoors, focused around the gospel.", "path": "/about/mission/", "banner": {"img": "/img/a45.webp", "alt": "Campers in the woods", "eyebrow": "Mission & Story", "title": "A safe place to spend the summer outdoors", "intro": "Camp exists so kids have a safe and loving place to spend their summer outdoors, focused around the gospel.", "h1": "eyebrow", "crumb": {"href": "/about/", "label": "About"}}}}>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <p class="eyebrow">Two verses, one name</p>
    <h2 class="h2" style="margin-bottom:32px">Where Hide and Seek comes from</h2>
    <div class="g2">
      <div class="card"><p class="eyebrow" style="color:#dda527;margin-bottom:12px">Matthew 6:33</p><p style="margin:0;font-size:23px;line-height:1.4;font-weight:500;letter-spacing:-.015em">"But SEEK first the kingdom of God and His righteousness and all of these things will be added to you"</p></div>
      <div class="card"><p class="eyebrow" style="color:#dda527;margin-bottom:12px">Psalm 119:11</p><p style="margin:0;font-size:23px;line-height:1.4;font-weight:500;letter-spacing:-.015em">"I have HIDDEN your word in my heart that I might not sin against you"</p></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap">
    <h2 class="h2" style="margin-bottom:32px">Eighteen summers</h2>
    <div class="g4">
      <div><div class="ph" style="height:200px"><img src="/img/a02.webp" alt="The first summer"></div><p class="s" style="margin-top:12px;color:#20180f;font-weight:600">The first summer at Hickory Flat</p></div>
      <div><div class="ph" style="height:200px"><img src="/img/a48.webp" alt="Building the ropes course"></div><p class="s" style="margin-top:12px;color:#20180f;font-weight:600">Building the ropes course</p></div>
      <div><div class="ph" style="height:200px"><img src="/img/a20.webp" alt="Ball Ground opens"></div><p class="s" style="margin-top:12px;color:#20180f;font-weight:600">Ball Ground opens</p></div>
      <div><div class="ph" style="height:200px"><img src="/img/a04.webp" alt="Sixes opens"></div><p class="s" style="margin-top:12px;color:#20180f;font-weight:600">Sixes opens</p></div>
    </div>
    <p class="s" style="margin-top:20px">Timeline dates to be confirmed with the camp office.</p>
  </div></div>
  <div class="sec" style="padding-top:0"><div class="wrap g2" style="gap:56px;align-items:center">
    <div class="ph" style="height:360px"><img src="/img/a30.webp" alt="Counselor and camper"></div>
    <div><p class="eyebrow">Open to everyone</p><h2 class="h2">Christ rooted, and no membership required</h2><p class="p">You do not need to belong to a church to belong at camp. Every family is welcome, and every camper hears the gospel from staff who love them.</p></div>
  </div></div>
</Layout>
