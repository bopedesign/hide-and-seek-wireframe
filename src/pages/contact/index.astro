---
import Layout from '../../layouts/Layout.astro';
---
<Layout {...{"title": "Contact the Camp Office | Hide and Seek Day Camp", "description": "Email or call and a real person will answer. Tell us which campus and which session you are asking about.", "path": "/contact/", "banner": {"pos": "50% 35%", "img": "/img/contact-header.webp", "alt": "Counselor and campers sitting on the pavement", "eyebrow": "Contact", "title": "Talk to the camp office", "intro": "Email or call and a real person will answer. Tell us which campus and which session you are asking about.", "h1": "title", "crumb": null}}}>
  <div class="sec"><div class="wrap" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:56px;align-items:start">
    <div>
      <div class="card"><p class="eyebrow" style="margin-bottom:14px">Camp office</p>
        <p style="margin:0 0 6px;font-size:30px;font-weight:600;letter-spacing:-.025em">info@hsdc.camp</p>
        <p style="margin:0 0 22px;font-size:30px;font-weight:600;letter-spacing:-.025em">(770) 720-0005</p>
        <p class="eyebrow" style="margin-bottom:6px">Mailing address</p>
        <p class="s">1894 Lower Union Hill Rd, Canton, GA 30115</p>
        <p class="s" style="margin-top:10px">Mail is received at the office address, not at any of the campuses.</p>
      </div>
      <div class="row" style="margin-top:22px"><a href="mailto:info@hsdc.camp" data-ev="email_click" class="gold">Email the office</a><a href="tel:+17707200005" data-ev="call_click" class="ghostD">Call the office</a></div>
    </div>
    <div class="ph" style="height:400px"><img src="/img/contact-02.webp" alt="Counselors with a group of campers" style="object-position:50% 40%"></div>
  </div></div>
  <div class="tint" style="padding:88px clamp(20px,3vw,40px)"><div class="wrap">
    <h2 class="h2">What are you trying to do?</h2><p class="p" style="margin-bottom:32px">Most questions have a faster answer than an email. Start here.</p>
    <div class="g3">
      <div class="card"><h3 class="h3">Register a camper</h3><p class="s" style="margin-bottom:14px">Sessions, availability, and payment are all handled in UltraCamp.</p><a href="https://www.ultracamp.com/clientlogin.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="register_click" target="_blank" rel="noopener" class="lk">Go to registration</a></div>
      <div class="card"><h3 class="h3">Ask about cost or a scholarship</h3><p class="s" style="margin-bottom:14px">Pricing is on the dates page. Scholarship requests are handled privately by the office.</p><a href="/parent-info/scholarships/" class="lk">Scholarships</a></div>
      <div class="card"><h3 class="h3">Check a policy or packing question</h3><p class="s" style="margin-bottom:14px">Hours, what to wear, what to bring, rain days, and group placement are all answered in the FAQ.</p><a href="/parent-info/faqs/" class="lk">Parent guide and FAQs</a></div>
      <div class="card"><h3 class="h3">Apply to work at camp</h3><p class="s" style="margin-bottom:14px">Applications run through UltraCamp, one per position.</p><a href="/get-involved/apply/" class="lk">Staff applications</a></div>
      <div class="card"><h3 class="h3">Ask about the 5K or the banquet</h3><p class="s" style="margin-bottom:14px">Race registration, sponsor packets, and banquet details live on their own pages.</p><a href="/get-involved/hickory-flatout-5k/" class="lk">Hickory FlatOut 5K</a></div>
      <div class="card"><h3 class="h3">Give to Seek Ministries</h3><p class="s" style="margin-bottom:14px">Gifts send kids to camp and keep the property running.</p><a href="https://www.ultracamp.com/donations/donationselection.aspx?idCamp=307&amp;campCode=hns&amp;idDonationCategory=2574" data-ev="donate_click" target="_blank" rel="noopener" class="lk">Donate</a></div>
    </div>
  </div></div>
  <div class="sec"><div class="wrap">
    <h2 class="h2">Reaching a campus during camp</h2><p class="p" style="margin-bottom:32px">During the camp day, call the office rather than the host church. Church staff cannot reach campers or counselors on the field.</p>
    <div class="g3">
      <div class="card"><h3 class="h3">Hickory Flat</h3><p class="s" style="margin-bottom:14px">Mt. Zion Baptist Church<br>4096 East Cherokee Drive<br>Canton, GA 30115</p><a href="/locations/hickory-flat/" class="lk">Directions and carpool</a></div>
      <div class="card"><h3 class="h3">Ball Ground</h3><p class="s" style="margin-bottom:14px">Ball Ground Methodist Church<br>3045 Canton Hwy<br>Ball Ground, GA 30107</p><a href="/locations/ball-ground/" class="lk">Directions and carpool</a></div>
      <div class="card"><h3 class="h3">Sixes</h3><p class="s" style="margin-bottom:14px">8385 Bells Ferry Road<br>Canton, GA 30114</p><a href="/locations/sixes/" class="lk">Directions and carpool</a></div>
    </div>
  </div></div>
  <div class="navyband" style="padding:60px clamp(20px,3vw,40px);border-radius:36px 36px 0 0"><div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
    <div><h2 class="h2" style="color:#fff;margin:0 0 6px">Follow camp through the summer</h2><p class="s" style="color:rgba(255,255,255,.7)">Our photography lead posts from all three campuses most days.</p></div>
    <div class="row"><span class="ghostL">Facebook</span><span class="ghostL">Instagram</span><a href="/explore-camp/gallery/" class="gold">See the gallery</a></div>
  </div></div>
</Layout>
