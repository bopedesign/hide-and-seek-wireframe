---
// The home page banner. It has a summer and a winter version of its words; the photo and layout are shared.
// Pick the version in src/pages/index.astro: <HomeHero season="summer" /> when summer camp registration opens,
// <HomeHero season="winter" /> while Winter Camp is the next thing to sign up for.
interface Props { season: 'summer' | 'winter' }
const { season } = Astro.props;
const register = 'https://www.ultracamp.com/clientlogin.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us';
const words = {
  // The original summer banner, kept word for word.
  summer: {
    eyebrow: 'Canton, Georgia &middot; Our 18th summer',
    h1: 'A safe place for a summer of real <span style="color:#dda527">outdoor fun</span>',
    intro: 'A Christ centered day camp for finished kindergarten through finished fifth grade, open to every family. Eight weeks of summer, three campuses, and counselors who know your child by name.',
    buttons: `<a href="${register}" data-ev="register_click" target="_blank" rel="noopener" class="gold" style="padding:15px 30px">Register for a session</a><a href="/parent-info/dates-hours-pricing/" class="ghostL">See dates and pricing</a>`,
  },
  // Winter: light blue in place of the gold, and the Winter Camp facts from the Winter Camp page.
  winter: {
    eyebrow: 'Canton, Georgia',
    h1: 'A safe place for a winter break of real <span style="color:#9fcbe8">outdoor fun</span>',
    intro: 'A Christ centered day camp between Christmas and New Year&rsquo;s for campers currently in kindergarten through fifth grade. December 29, 30, and 31 at Hickory Flat. Same staff, same games, colder woods.',
    buttons: `<a href="${register}" data-ev="register_click" target="_blank" rel="noopener" class="gold" style="padding:15px 30px">Register for Winter Camp</a><a href="/explore-camp/winter-camp/" class="ghostL">See Winter Camp details</a>`,
  },
};
const t = words[season];
---
<div class="hero-home">
    <picture><source media="(max-width:600px)" srcset="/img/home-header-3.webp"><img src="/img/gallery-dsc00345.webp" alt="Campers sitting together smiling outside" style="object-position:50% 85%;position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></picture>
    <div style="position:absolute;inset:0;background:radial-gradient(115% 72% at 18% 100%,rgba(36,91,131,.62) 0%,rgba(36,91,131,0) 64%),linear-gradient(90deg,rgba(11,38,60,.56) 0%,rgba(11,38,60,.14) 58%,transparent 100%),linear-gradient(180deg,rgba(11,38,60,.72) 0%,rgba(11,38,60,.22) 26%,rgba(10,34,54,.52) 52%,rgba(8,28,45,.93) 82%,rgba(8,28,45,.97) 100%)"></div>
    <div style="position:absolute;left:0;right:0;bottom:0;padding:0 clamp(20px,3vw,40px) 64px">
      <div class="wrap" style="display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:56px;align-items:end">
        <div>
          <p style="margin:0 0 18px;color:#9fcbe8;font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase"><Fragment set:html={t.eyebrow} /></p>
          <h1 style="margin:0;color:#fff;font-size:68px;line-height:1.02;font-weight:600;letter-spacing:-.03em;max-width:15ch;text-wrap:pretty"><Fragment set:html={t.h1} /></h1>
        </div>
        <div style="padding-bottom:8px">
          <p style="margin:0 0 22px;color:rgba(255,255,255,.94);font-size:15px;line-height:1.65;max-width:46ch"><Fragment set:html={t.intro} /></p>
          <div class="row"><Fragment set:html={t.buttons} /></div>
        </div>
      </div>
    </div>
  </div>
