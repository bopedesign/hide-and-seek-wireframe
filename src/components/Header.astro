---
// Header with the four dropdown menus from the design. Menus open on hover and on keyboard focus; under 1080px a menu button
// opens one list of every page instead.
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href="/" class="logo-link" aria-label="Hide and Seek Day Camp home"><img src="/brand/hs-logo-white.png" alt="Hide and Seek Day Camp" width="640" height="190" class="logo"></a>
    <nav class="nv" aria-label="Main">
    <ul class="nv-ul">
      <li class="nv-li">
        <a class="nvi" href="/explore-camp/" aria-haspopup="true">Explore Camp <span class="caret" aria-hidden="true">▾</span></a>
        <div class="mm"><div class="mm-in"><div class="mm-col"><p class="mm-k">Camp Programs</p><div class="mm-l"><a href="/explore-camp/summer-day-camp/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>Summer Day Camp</a><a href="/explore-camp/seek-adventure/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>SEEK Adventure</a><a href="/explore-camp/winter-camp/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="m2 12 20 0"/><path d="m12 2 0 20"/><path d="m4.9 4.9 14.2 14.2"/><path d="m19.1 4.9-14.2 14.2"/></svg>Winter Camp</a></div></div>
        <div class="mm-col"><p class="mm-k">See Camp</p><div class="mm-l"><a href="/explore-camp/camp-experience/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>Camp Experience</a><a href="/explore-camp/gallery/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m21 15-4.35-4.35a2 2 0 0 0-2.83 0L4 21"/></svg>Gallery</a><a href="/locations/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3z"/><path d="M9 3v15"/><path d="M15 6v15"/></svg>Locations</a></div></div>
                <div><div class="ph" style="height:120px"><img src="/img/summer-05.webp" alt="Camper in a helmet climbing up to the zipline"></div><p class="s" style="margin-top:10px;font-weight:600;color:#20180f">Registration opens March 1</p></div></div></div>
      </li>
      <li class="nv-li">
        <a class="nvi" href="/parent-info/" aria-haspopup="true">Parent Info <span class="caret" aria-hidden="true">▾</span></a>
        <div class="mm"><div class="mm-in"><div class="mm-col"><p class="mm-k">Plan the summer</p><div class="mm-l"><a href="/parent-info/dates-hours-pricing/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>Dates, Hours &amp; Pricing</a></div></div>
        <div class="mm-col"><p class="mm-k">Prepare</p><div class="mm-l"><a href="/parent-info/safety/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>Safety</a><a href="/parent-info/faqs/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>Parent Guide &amp; FAQs</a></div></div>
        <div class="mm-col"><p class="mm-k">Financial Assistance</p><div class="mm-l"><a href="/parent-info/scholarships/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z"/></svg>Scholarships</a></div></div>
        <div><div class="ph" style="height:120px"><img src="/img/gallery-mg2432.webp" alt="Counselor and camper smiling at a picnic table"></div><p class="s" style="margin-top:10px;font-weight:600;color:#20180f">Camp runs 9 a.m. to 3 p.m.</p></div></div></div>
      </li>
      <li class="nv-li">
        <a class="nvi" href="/about/" aria-haspopup="true">About <span class="caret" aria-hidden="true">▾</span></a>
        <div class="mm"><div class="mm-in"><div class="mm-col"><p class="mm-k">The ministry</p><div class="mm-l"><a href="/about/seek-ministries/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z"/></svg>Seek Ministries</a></div></div>
        <div class="mm-col"><p class="mm-k">Who we are</p><div class="mm-l"><a href="/about/mission/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>Mission &amp; Story</a></div></div>
        <div class="mm-col"><p class="mm-k">Reach us</p><div class="mm-l"><a href="/contact/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>Contact</a></div></div>
        <div><div class="ph" style="height:120px"><img src="/img/about-01.webp" alt="The whole camp together for a group photo"></div><p class="s" style="margin-top:10px;font-weight:600;color:#20180f">Our 18th summer of camp</p></div></div></div>
      </li>
      <li class="nv-li">
        <a class="nvi" href="/get-involved/" aria-haspopup="true">Get Involved <span class="caret" aria-hidden="true">▾</span></a>
        <div class="mm"><div class="mm-in"><div class="mm-col"><p class="mm-k">Join the staff</p><div class="mm-l"><a href="/get-involved/work-at-camp/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>Work at Camp</a><a href="/get-involved/apply/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13h4"/><path d="M10 17h4"/></svg>Apply</a></div></div>
        <div class="mm-col"><p class="mm-k">Events</p><div class="mm-l"><a href="/get-involved/hickory-flatout-5k/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.68V16a2 2 0 1 1-4 0z"/><path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.68V20a2 2 0 1 0 4 0z"/></svg>Hickory FlatOut 5K</a><a href="/get-involved/annual-banquet/"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h2a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/></svg>Annual Banquet</a></div></div>
        <div class="mm-col"><p class="mm-k">Give</p><div class="mm-l"><a href="https://www.ultracamp.com/donations/donationselection.aspx?idCamp=307&amp;campCode=hns&amp;idDonationCategory=2574" data-ev="donate_click" target="_blank" rel="noopener"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>Donate</a></div></div>
        <div><div class="ph" style="height:120px"><img src="/img/involved-01.webp" alt="Counselors with the camp utility vehicle" style="object-position:85% 50%"></div><p class="s" style="margin-top:10px;font-weight:600;color:#20180f">The 5K runs Labor Day morning</p></div></div></div>
      </li>
      <li class="nv-li"><a class="nvi" href="/contact/">Contact</a></li>
    </ul>
    </nav>
    <div class="hdr-cta">
      <a class="ghostL hdr-btn" href="https://www.ultracamp.com/donations/donationselection.aspx?idCamp=307&amp;campCode=hns&amp;idDonationCategory=2574" data-ev="donate_click" target="_blank" rel="noopener">Donate</a>
      <a class="gold hdr-btn" href="https://www.ultracamp.com/clientlogin.aspx?idCamp=307&amp;campcode=hns&amp;lang=en-Us" data-ev="register_click" target="_blank" rel="noopener">Register</a>
      <button class="mob-btn" type="button" aria-expanded="false" aria-controls="mob-menu">Menu</button>
    </div>
  </div>
  <div class="mob" id="mob-menu" hidden><div class="mob-g"><a class="mob-top" href="/explore-camp/">Explore Camp</a><a href="/explore-camp/summer-day-camp/">Summer Day Camp</a><a href="/explore-camp/seek-adventure/">SEEK Adventure</a><a href="/explore-camp/winter-camp/">Winter Camp</a><a href="/explore-camp/camp-experience/">Camp Experience</a><a href="/explore-camp/gallery/">Gallery</a><a href="/locations/">Locations</a></div><div class="mob-g"><a class="mob-top" href="/parent-info/">Parent Info</a><a href="/parent-info/dates-hours-pricing/">Dates, Hours &amp; Pricing</a><a href="/parent-info/safety/">Safety</a><a href="/parent-info/faqs/">Parent Guide &amp; FAQs</a><a href="/parent-info/scholarships/">Scholarships</a></div><div class="mob-g"><a class="mob-top" href="/about/">About</a><a href="/about/seek-ministries/">Seek Ministries</a><a href="/about/mission/">Mission &amp; Story</a><a href="/contact/">Contact</a></div><div class="mob-g"><a class="mob-top" href="/get-involved/">Get Involved</a><a href="/get-involved/work-at-camp/">Work at Camp</a><a href="/get-involved/apply/">Apply</a><a href="/get-involved/hickory-flatout-5k/">Hickory FlatOut 5K</a><a href="/get-involved/annual-banquet/">Annual Banquet</a><a href="https://www.ultracamp.com/donations/donationselection.aspx?idCamp=307&amp;campCode=hns&amp;idDonationCategory=2574" data-ev="donate_click" target="_blank" rel="noopener">Donate</a></div></div>
</header>
<script is:inline>
  (function () {
    var b = document.querySelector('.mob-btn'), p = document.getElementById('mob-menu');
    b.addEventListener('click', function () { var open = p.hidden; p.hidden = !open; b.setAttribute('aria-expanded', open ? 'true' : 'false'); b.textContent = open ? 'Close' : 'Menu'; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && document.activeElement && document.activeElement.closest('.nv-li')) document.activeElement.blur(); });
  })();
</script>
